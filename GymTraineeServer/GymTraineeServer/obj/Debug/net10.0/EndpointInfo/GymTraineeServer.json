{
  "openapi": "3.1.1",
  "info": {
    "title": "GymTraineeServer | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://[::]:5000"
    }
  ],
  "paths": {
    "/api/v1/GymTrainee/programs": {
      "get": {
        "tags": [
          "GymTrainee"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/IProgram"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/IProgram"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/IProgram"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/GymTrainee/programs/add": {
      "post": {
        "tags": [
          "GymTrainee"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Program"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/Program"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/Program"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/GymTrainee/exercises/add": {
      "post": {
        "tags": [
          "GymTrainee"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Exercise"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/Exercise"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/Exercise"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Exercise": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/ExerciseTypeEnum"
          },
          "tag": {
            "$ref": "#/components/schemas/ExerciseTagEnum"
          },
          "trainingDayToExercise": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/TrainingDayToExercise"
            }
          }
        }
      },
      "ExerciseTagEnum": {
        "type": "integer"
      },
      "ExerciseTypeEnum": {
        "type": "integer"
      },
      "IExercise": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "maxWeightCoef": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "count": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "reps": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "passed": {
            "type": "boolean"
          },
          "type": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ExerciseTypeEnum"
              }
            ]
          }
        }
      },
      "IProgram": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "trainigDays": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ITrainingDay"
            }
          }
        }
      },
      "ITrainingDay": {
        "type": "object",
        "properties": {
          "trainingNumber": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "exercises": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IExercise"
            }
          }
        }
      },
      "Program": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "trainigDays": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TrainingDay"
            }
          }
        }
      },
      "TrainingDay": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "trainingNumber": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "programId": {
            "type": "string",
            "format": "uuid"
          },
          "program": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Program"
              }
            ]
          },
          "exercises": {
            "$ref": "#/components/schemas/Exercise/properties/trainingDayToExercise/items/properties/trainingDay/properties/program/properties/trainigDays/items/properties/exercises"
          }
        }
      },
      "TrainingDayToExercise": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "maxWeightCoef": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "count": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "reps": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "passed": {
            "type": "boolean"
          },
          "trainingDayId": {
            "type": "string",
            "format": "uuid"
          },
          "trainingDay": {
            "$ref": "#/components/schemas/TrainingDay"
          },
          "exerciseId": {
            "type": "string",
            "format": "uuid"
          },
          "exercise": {
            "$ref": "#/components/schemas/Exercise"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "GymTrainee"
    }
  ]
}